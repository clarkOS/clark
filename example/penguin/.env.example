# ClarkOS Environment Configuration
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ====================
# REQUIRED
# ====================

# Convex deployment URL
# Get from: https://dashboard.convex.dev
# Format: https://your-project.convex.cloud
CONVEX_URL=

# LLM API Key (OpenRouter recommended)
# Get from: https://openrouter.ai/keys
# Format: sk-or-v1-xxxxx
OPENROUTER_KEY=

# Embedding API Key (Gemini recommended - free tier)
# Get from: https://aistudio.google.com/apikey
# Format: AIzaSy-xxxxx
GEMINI_API_KEY=

# ====================
# OPTIONAL - AUTH
# ====================

# Auth token for tick operations
# Generate: openssl rand -hex 32
# TICK_TOKEN=

# Auth token for write operations
# Generate: openssl rand -hex 32
# WRITE_TOKEN=

# ====================
# OPTIONAL - LLM
# ====================

# LLM provider: openrouter | openai | anthropic | custom
# Default: openrouter
# LLM_PROVIDER=openrouter

# Model ID
# Default: anthropic/claude-3.5-haiku (OpenRouter)
# OpenRouter models: https://openrouter.ai/models
# MODEL_ID=anthropic/claude-3.5-haiku

# Alternative API keys (if not using OpenRouter)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Custom LLM endpoint (for custom provider)
# LLM_BASE_URL=

# Generation parameters
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# ====================
# OPTIONAL - EMBEDDINGS
# ====================

# Embedding provider: gemini | openai | custom
# Default: gemini
# EMBEDDING_PROVIDER=gemini

# Embedding model
# Gemini default: text-embedding-004 (768 dimensions)
# OpenAI default: text-embedding-3-small (1536 dimensions)
# EMBEDDING_MODEL=

# Custom embedding endpoint
# EMBEDDING_BASE_URL=

# ====================
# OPTIONAL - AGENT
# ====================

# Agent name
# Default: Agent
# AGENT_NAME=MyAgent

# Tick interval in milliseconds
# Default: 60000 (1 minute)
# TICK_INTERVAL=60000

# Auto-start ticking
# Default: false
# AUTO_TICK=false

# Memory consolidation threshold
# Default: 100
# MEMORY_THRESHOLD=100

# Verbose logging
# Default: false
# VERBOSE=false
